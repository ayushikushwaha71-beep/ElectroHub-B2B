def seed(apps, schema_editor):
    User = apps.get_model('accounts', 'CustomUser')
    Vendor = apps.get_model('accounts', 'VendorProfile')
    Product = apps.get_model('products', 'Product')
    vendors = {}
    for index, name in enumerate(['Techtron Electronics', 'RoboParts India', 'CircuitHub Technologies', 'Embedded World', 'Maker Components']):
        user = User.objects.create(email=f'seed-{index}@electrohub.local', username=f'seed-{index}@electrohub.local', first_name=name.split()[0], password='!seed-only!', role='vendor')
        vendors[name] = Vendor.objects.create(user=user, business_name=name, city='Bengaluru', status='approved')
    for external_id, name, sku, category, brand, price, original, stock, image, vendor_name in CATALOGUE:
        Product.objects.create(external_id=external_id, name=name, slug=external_id, sku=sku, category_name=category, brand_name=brand, price=price, discount_price=price, stock=stock, vendor=vendors[vendor_name], image=f'products/{image}', short_description=f'{name} for makers and engineers.', description=f'{name} from ElectroHub marketplace.')

def unseed(apps, schema_editor):
    apps.get_model('products', 'Product').objects.filter(external_id__isnull=False).delete()
    apps.get_model('accounts', 'VendorProfile').objects.filter(user__username__startswith='seed-').delete()
    apps.get_model('accounts', 'CustomUser').objects.filter(username__startswith='seed-').delete()

class Migration(migrations.Migration):
    dependencies = [('products', '0002_product_external_id')]
